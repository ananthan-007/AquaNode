# ─── Required ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# "simulator" (default, no hardware needed) or "supabase" (real device + backend)
NEXT_PUBLIC_DEVICE_DATA_SOURCE=simulator

# Your public app URL — used for auth callback redirects
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────

# Supabase service role key — used ONLY in Route Handlers (ingest, handshake,
# discovery). Never sent to the browser. Never commit to git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How long without a heartbeat/telemetry before dashboard shows STALE (ms).
# Default: 30000 (30s). Placeholder — confirm with hardware team once the
# real ESP32 heartbeat interval is known (firmware default: 8s heartbeats).
# DEVICE_STALE_TIMEOUT_MS=30000

# ESP32 device Bearer token for the ingest endpoint.
# In development: use the default "dev-device-token-secret" (no setup required).
# In production: provision a unique token per device and store the hash in
# the device_tokens Supabase table.
# HARDWARE_DEVICE_TOKEN=dev-device-token-secret

# ─── ESP32 Firmware Configuration ─────────────────────────────────────────────
# The following variables belong in the ESP32 firmware (aquaguard_esp32.ino),
# NOT in the PWA .env files. They are documented here for reference only.
#
# ESP32 firmware constants (set in the .ino file before flashing):
#   WIFI_SSID        — your Wi-Fi network name
#   WIFI_PASSWORD    — your Wi-Fi password
#   BACKEND_URL      — https://your-app.vercel.app  (your Vercel deployment)
#   DEVICE_TOKEN     — dev-device-token-secret  (or production per-device token)
#
# The DEVICE_ID is derived automatically from the ESP32 MAC address at runtime:
#   format: AQ-ESP32-XXXXXXXXXXXX  (12 hex chars of MAC)
#
# IMPORTANT: The backend URL is configured in the ESP32 firmware, NOT in the PWA.
# The PWA uses backend-powered discovery (GET /api/device/devices).
# The PWA never connects directly to 192.168.x.x or a local ESP32 IP.
#
# ─── Demo account setup ───────────────────────────────────────────────────────
# Create the shared Supabase Auth account:
#   Supabase Dashboard → Authentication → Users → Add user
# Share credentials via a password manager. Never put them in .env files.
#
# ─── DO NOT ADD ───────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY must never be NEXT_PUBLIC_ prefixed.
# Never expose device tokens or service keys in client-side code.
